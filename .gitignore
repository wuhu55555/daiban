# ============================================
# 全栈项目 .gitignore（前端 + 后端 + 数据库）
# 覆盖：Node.js / Java / Python 后端 + 前端 + 本地数据库
# 用法：复制到项目根目录，重命名为 .gitignore
# ============================================

# ---- 依赖 ----
node_modules/
frontend/node_modules/
backend/node_modules/
bower_components/

# ---- 构建产物 ----
dist/
build/
out/
release/
frontend/dist/
backend/dist/
*.tsbuildinfo

# ---- 后端运行产物 ----
logs/
*.log
npm-debug.log*
yarn-error.log*
pidfile.pid
*.pid

# ---- 测试与覆盖率 ----
coverage/
.pytest_cache/
.njssrc/

# ---- 环境变量与密钥（重点！绝不提交）----
.env
.env.*
.env.local
.env.production
.env.development
!.env.example          # 保留示例文件，可提交
*.pem
*.key
*.p12
id_rsa*
*.cer

# ---- 本地数据库（数据不进 git）----
*.sqlite
*.sqlite3
*.db
data/*.db
data/*.sqlite*

# ---- 上传 / 临时文件 ----
uploads/
tmp/
temp/
runtime/

# ============================================
# 按后端语言可选的段落（用不到就整段删除）
# ============================================

# ---- Python 后端 ----
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.python-version

# ---- Java 后端 ----
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---- Node 后端额外 ----
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
